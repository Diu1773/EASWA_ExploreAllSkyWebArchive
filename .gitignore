# Generated / scratch
# 설문 미리보기 생성물 (소스 .gs에서 재생성). 인라인 주석 금지 — gitignore는
# 패턴 뒤 주석을 패턴의 일부로 먹어 매칭이 깨진다.
docs/survey/_preview_*.html
/d.txt
/dep.txt

# Env
.env
.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# Runtime data
backend/*.db
backend/*.db-shm
backend/*.db-wal
backend/.cache/
backend/submissions/
# Demo cutouts: the WASP-6 b practice cutout is committed so the image always
# ships it (no build-time MAST dependency). Any other FITS placed here stays
# untracked.
backend/bundled_cutouts/*
!backend/bundled_cutouts/wasp_6_b__wasp_6_b_sector_0002__s0002__50px.fits
_scratch_bundle/

# 캡처 사본 (원본은 docs/screens_live/ 에 추적됨)
docs/캡처_*/

# 시트 원자료 내보내기 (익명이지만 UA 문자열 포함 - 커밋하지 않음)
docs/survey/data/
